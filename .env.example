# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=production
# Both need a DNS A record pointing at this server.
API_DOMAIN=api.replisto.app
PANEL_DOMAIN=app.replisto.app
PUBLIC_BASE_URL=https://api.replisto.app
# The panel; users land on FRONTEND_URL/instagram/callback after connecting Instagram
FRONTEND_URL=https://app.replisto.app
# Shown on the panel's /privacy, /terms and /data-deletion pages (Meta checks these)
SUPPORT_EMAIL=support@replisto.app
# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["https://app.replisto.app"]

# Seconds to wait after a customer's message so a burst of messages gets one reply
REPLY_DEBOUNCE_SECONDS=5

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this makes stored Instagram tokens unreadable.
ENCRYPTION_KEY=

# ---------------------------------------------------------------- Instagram
# true = shops can connect Instagram. Set to false to pause it server-wide (e.g. while the
# Meta app is in review).
INSTAGRAM_ENABLED=true
# From the Meta App Dashboard (Instagram > API setup with Instagram login).
# Use the *Instagram* app ID/secret shown there, not the Facebook app ID.
META_APP_ID=
META_APP_SECRET=
# Any random string; enter the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
# The app asks for these permissions (all under "Instagram API with Instagram login"):
#   instagram_business_basic, instagram_business_manage_messages,
#   instagram_business_manage_comments, instagram_business_content_publish,
#   instagram_business_manage_insights
# Webhook fields to subscribe in the App Dashboard: messages, comments.

# Scheduled stories: files wait here until published; Instagram downloads them from
# PUBLIC_BASE_URL/api/v1/media/... so the API must be reachable over HTTPS.
MEDIA_DIR=media

# Any OpenAI-compatible endpoint (OpenAI directly, or a gateway such as OpenRouter)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# A fast model that supports tool/function calling, e.g. a mini/flash/haiku-class model.
LLM_MODEL=
# Optional: a model that accepts images, for reading uploaded price-list photos.
LLM_VISION_MODEL=
LLM_MAX_OUTPUT_TOKENS=700

# Per-shop limits
KNOWLEDGE_CHAR_LIMIT=40000
PRODUCT_ROW_LIMIT=2000
PRODUCT_SYNC_INTERVAL_MINUTES=5

# ---------------------------------------------------------------- Wallet (pay as you go)
# All amounts in US cents. Every AI answer is deducted from the shop's wallet: tokens used x
# price (fractions of a cent are fine), rounded up to a cent, with a minimum per answer.
# false = nothing is charged.
BILLING_ENABLED=true
# Gift credit for a new shop ($5). Given once per person, after the owner verifies their
# mobile number. 0 = no gift.
SIGNUP_CREDIT_CENTS=500
# true: the gift comes after verifying a mobile number by SMS. false (a test server without
# SMS): every new account gets it right at sign-up.
GIFT_REQUIRES_PHONE=true
USAGE_CENTS_PER_1K_PROMPT_TOKENS=0.05
USAGE_CENTS_PER_1K_COMPLETION_TOKENS=0.2
USAGE_MIN_CENTS_PER_REPLY=1
# The owner is warned below this balance
LOW_BALANCE_CENTS=200
TOPUP_MIN_CENTS=500
TOPUP_MAX_CENTS=100000
# A customer gets at most this many bot answers per hour (protects the wallet from spam)
MAX_BOT_REPLIES_PER_CUSTOMER_HOUR=30
# Questions unrelated to the shop (weather, homework...) get a short canned reply in the
# customer's language instead of a full AI answer, and aren't charged; after
# OFF_TOPIC_MAX_REPLIES in a row the bot stays quiet until the customer asks about the shop.
# A small AI call decides when it isn't obvious; LLM_TRIAGE_MODEL can be a cheaper model for
# it (empty = LLM_MODEL).
OFF_TOPIC_GUARD=true
OFF_TOPIC_MAX_REPLIES=2
LLM_TRIAGE_MODEL=

# ---------------------------------------------------------------- "Ask Replisto" on the website
# Replisto's own shop answers visitors on the site. Create it once with:
#   docker compose exec api python -m scripts.seed_house --email <team account>
# Daily AI-token allowances (one answer is roughly 3,000-5,000 tokens):
SITE_CHAT_GUEST_TOKENS=25000
SITE_CHAT_MEMBER_TOKENS=100000
SITE_CHAT_IP_TOKENS=150000
SITE_CHAT_DAILY_TOKENS=3000000

# Wallet top-ups in Lebanon: Whish Money and OMT transfers. The owner sends the amount to the
# account below, enters the transfer reference in the panel, and the team checks it:
#   docker compose exec api python -m scripts.wallet pending
#   docker compose exec api python -m scripts.wallet approve <payment-id>
#   docker compose exec api python -m scripts.wallet reject <payment-id> "<reason>"
# Leave a method empty to hide it. OPS_EMAIL is told about each transfer to check (needs SMTP).
WHISH_ACCOUNT=
OMT_ACCOUNT=
OPS_EMAIL=
# Credit a wallet by hand (support, corrections):
#   docker compose exec api python -m scripts.wallet credit <email> <dollars> "<note>"

# Optional card top-ups through Stripe Checkout. Stripe doesn't accept businesses registered
# in Lebanon: use it only if Replisto is operated by a company in a Stripe country.
# From the Stripe dashboard: Developers → API keys (sk_test_… for testing, sk_live_… for real)
# and Developers → Webhooks: add the endpoint
#   https://<api domain>/api/v1/billing/stripe/webhook
# listening to checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed and checkout.session.expired; paste its signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Email (verification, password reset)
# Without SMTP_HOST the links are only written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Replisto <no-reply@replisto.app>
SMTP_STARTTLS=true
# true for port 465 (SSL from the start); keep false with 587 + STARTTLS
SMTP_SSL=false
# Email owners when a customer is waiting for them and when the wallet runs low or out.
EMAIL_ALERTS=true
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USERNAME=<SMTP login>  SMTP_PASSWORD=<SMTP key>
# Resend: SMTP_HOST=smtp.resend.com       SMTP_PORT=587  SMTP_USERNAME=resend         SMTP_PASSWORD=<API key>
# Check with: docker compose exec api python -m scripts.send_test_email you@example.com

# ---------------------------------------------------------------- SMS (verifying mobile numbers)
# Twilio sends the codes. For Lebanon use a Messaging Service SID (MG...) with an alphanumeric
# sender ("Replisto") registered for Lebanon, or a Twilio number. Without an account SID the
# codes are only written to the API log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Numbers typed without a country code ("70 123 456") are in this country (961 = Lebanon).
DEFAULT_PHONE_COUNTRY_CODE=961

# Wrong passwords: after this many failures for one email within the window (minutes), login
# is refused until the window passes.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# ---------------------------------------------------------------- Monitoring and backups
# Optional: Sentry (or self-hosted GlitchTip) project DSN for error reports.
SENTRY_DSN=
# Backups run every BACKUP_INTERVAL_HOURS and are kept BACKUP_KEEP_DAYS in ./backups.
# Optional off-site copy: with a passphrase, a Telegram bot token and a chat id, each dump is
# also encrypted and sent to that chat (keep the passphrase in a password manager: without it
# the copies can't be opened). See deploy/backup/RESTORE.md.
BACKUP_PASSPHRASE=
TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_DAYS=14
