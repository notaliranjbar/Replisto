# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=production
# Both need a DNS A record pointing at this server.
API_DOMAIN=api.replisto.app
PANEL_DOMAIN=app.replisto.app
PUBLIC_BASE_URL=https://api.replisto.app
# The panel; users land on FRONTEND_URL/instagram/callback after connecting Instagram
FRONTEND_URL=https://app.replisto.app
# Shown on the panel's /privacy, /terms and /data-deletion pages (Meta checks these)
SUPPORT_EMAIL=support@replisto.app
# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["https://app.replisto.app"]

# Seconds to wait after a customer's message so a burst of messages gets one reply
REPLY_DEBOUNCE_SECONDS=5

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this makes stored Instagram tokens unreadable.
ENCRYPTION_KEY=

# ---------------------------------------------------------------- Telegram (first channel)
# The shared "Replisto" bot: create it in @BotFather (/newbot), paste its token here. On start
# the API points the bot's webhook at PUBLIC_BASE_URL/webhooks/telegram/... by itself.
# In @BotFather also turn on: Bot Settings > Business Mode (for Telegram Business).
TELEGRAM_BOT_TOKEN=
# The shared bot on Bale (بله): in the Bale app, message @botfather, /newbot, paste the token.
# Bale's API is Telegram-compatible; the same bot answers there (no VPN needed for customers).
BALE_BOT_TOKEN=

# ---------------------------------------------------------------- Instagram
# Off until the Meta app is approved; the code stays ready. true = show "connect Instagram".
INSTAGRAM_ENABLED=false
# From the Meta App Dashboard (Instagram > API setup with Instagram login).
# Use the *Instagram* app ID/secret shown there, not the Facebook app ID.
META_APP_ID=
META_APP_SECRET=
# Any random string; enter the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Any OpenAI-compatible endpoint (OpenAI directly or an Iranian gateway)
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=
# A fast model that supports tool/function calling, e.g. a mini/flash/haiku-class model.
LLM_MODEL=gpt-6-luna
# Optional: a model that accepts images, for reading uploaded price-list photos.
LLM_VISION_MODEL=
LLM_MAX_OUTPUT_TOKENS=700

# Per-shop limits
KNOWLEDGE_CHAR_LIMIT=40000
PRODUCT_ROW_LIMIT=2000
PRODUCT_SYNC_INTERVAL_MINUTES=5

# ---------------------------------------------------------------- Wallet (pay as you go)
# All amounts in RIAL (1 toman = 10 rial). Every AI answer is deducted from the shop's wallet:
# tokens used x price, with a minimum per answer. false = nothing is charged.
BILLING_ENABLED=true
# Gift credit for a new shop (500,000 rial = 50,000 toman). Given once per person, only after
# the owner links their Telegram/Bale account and (if the next line is true) verifies their
# mobile number. 0 = no gift.
SIGNUP_CREDIT_RIAL=500000
SIGNUP_GIFT_REQUIRES_PHONE=true
USAGE_RIAL_PER_1K_PROMPT_TOKENS=300
USAGE_RIAL_PER_1K_COMPLETION_TOKENS=1200
USAGE_MIN_RIAL_PER_REPLY=500
# The owner is warned in Telegram below this balance
LOW_BALANCE_RIAL=100000
# Monthly fee of the higher plans (paid from the wallet)
PLAN_PRO_MONTHLY_RIAL=2000000
PLAN_BUSINESS_MONTHLY_RIAL=4000000
TOPUP_MIN_RIAL=500000
TOPUP_MAX_RIAL=500000000
# A customer gets at most this many bot answers per hour (protects the wallet from spam)
MAX_BOT_REPLIES_PER_CUSTOMER_HOUR=30

# Wallet top-ups: aban (Aban Gateway: card-to-card, confirmed automatically from the bank SMS,
# no e-Namad needed) or zarinpal. Without the gateway's keys online top-up is off; top up by
# hand from the bot's /ops panel, or with
#   docker compose exec api python -m scripts.wallet credit <email> <toman> "<note>"
PAYMENT_GATEWAY=aban
# From abangateway.ir panel: Settings → API tokens (ag_test_… for testing without money,
# ag_live_… for real) and Settings → Webhook (the secret). The webhook address Aban calls is
# https://<api domain>/api/v1/billing/aban/webhook (sent with every invoice automatically).
ABAN_API_TOKEN=
ABAN_WEBHOOK_SECRET=
ABAN_INVOICE_MINUTES=30

# Zarinpal (only with PAYMENT_GATEWAY=zarinpal)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ---------------------------------------------------------------- Email (verification, password reset)
# Without SMTP_HOST the links are only written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Replisto <no-reply@replisto.app>
SMTP_STARTTLS=true

# ---------------------------------------------------------------- SMS (verifying mobile numbers)
# kavenegar or smsir. Both send the code through a "verify" template you create (and they
# approve) in their panel, with one parameter for the code: Kavenegar %token, SMS.ir CODE.
# SMS_TEMPLATE is the template name (Kavenegar) or its id (SMS.ir). Empty provider: codes are
# only written to the API log. Owners can also verify for free by sharing their contact with
# the Telegram/Bale bot.
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE=

# Wrong passwords: after this many failures for one email within the window (minutes), login
# is refused until the window passes.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# ---------------------------------------------------------------- Monitoring and backups
# Optional: Sentry (or self-hosted GlitchTip) project DSN for error reports.
SENTRY_DSN=
# Telegram chat (a private group of the team, or your own user id) that receives error
# alerts and the encrypted database backups from the shared bot. Get the id by adding
# @userinfobot to the group, or messaging it yourself.
OPS_TELEGRAM_CHAT_ID=
# The team's Telegram user ids (comma separated). In the shared Telegram bot they send /ops
# and get the admin panel: stats, shops, manual credit, suspend, payments, broadcast.
# New sign-ups and payments are announced to OPS_TELEGRAM_CHAT_ID, or to these ids.
OPS_ADMIN_TELEGRAM_IDS=
# Backups run every BACKUP_INTERVAL_HOURS and are kept BACKUP_KEEP_DAYS in ./backups.
# With a passphrase, an encrypted copy also goes to OPS_TELEGRAM_CHAT_ID (keep the
# passphrase in a password manager: without it the copies can't be opened).
BACKUP_PASSPHRASE=
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_DAYS=14
